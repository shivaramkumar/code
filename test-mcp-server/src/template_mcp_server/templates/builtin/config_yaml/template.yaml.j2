# Application Configuration
# Auto-generated by MCP Template Server
app:
  name: "{{ app_name }}"
  version: "{{ version }}"
  environment: "{{ environment }}"

server:
  port: {{ port | default(8080) }}
  debug: {{ debug | lower if debug is boolean else ('true' if debug else 'false') }}
  log_level: "{{ log_level | default('INFO') }}"

database:
  url: "{{ database_url | default('sqlite:///app.db') }}"
  pool_size: {{ pool_size | default(10) }}
