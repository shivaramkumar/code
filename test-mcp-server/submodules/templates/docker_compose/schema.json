{
  "name": "docker_compose",
  "version": "1.0.0",
  "description": "Docker Compose configuration for containerized service and database",
  "file_type": "yaml",
  "default_filename": "docker-compose.yml",
  "parameters": {
    "project_name": {
      "type": "string",
      "description": "Name of the project",
      "default": "my-project",
      "required": true
    },
    "app_image": {
      "type": "string",
      "description": "Container image for the main app",
      "default": "python:3.11-slim",
      "required": false
    },
    "app_port": {
      "type": "integer",
      "description": "Exposed application port",
      "default": 8000,
      "required": false
    },
    "include_postgres": {
      "type": "boolean",
      "description": "Whether to include a PostgreSQL database service",
      "default": true,
      "required": false
    },
    "postgres_version": {
      "type": "string",
      "description": "PostgreSQL image version tag",
      "default": "16-alpine",
      "required": false
    }
  }
}
